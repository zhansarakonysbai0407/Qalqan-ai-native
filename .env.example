# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
POSTGRES_DB=qalqan
POSTGRES_USER=qalqan
POSTGRES_PASSWORD=change-this-local-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password
GHCR_OWNER=your-github-owner
IMAGE_TAG=dev
# Optional: enables model-backed AI summaries. Without it, safe rule-based summaries are used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Local OTLP collector endpoint; use a protected external endpoint in hosted environments.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
